# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Database ----
# `npm run db:start` launches an embedded Postgres on port 5433 with these credentials.
DATABASE_URL=postgresql://apiforge:apiforge@localhost:5433/apiforge

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12

# ---- Secrets encryption (environment variables marked secret) ----
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- Background jobs (optional) ----
# When set, test runs are executed by a BullMQ worker (`npm run worker`). When empty, they run in-process.
REDIS_URL=

# ---- AI (optional) ----
# When set, AI test generation and failure summaries use Claude. Without it, a built-in
# rule-based generator is used so the app still works fully offline.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Request execution engine (SSRF protection) ----
REQUEST_TIMEOUT_MS=30000
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5
# Hostnames that may resolve to private addresses. DEV ONLY — leave empty in production.
SSRF_ALLOWLIST=
